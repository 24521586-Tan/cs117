SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local faster-whisper transcription.
#   WHISPER_MODEL: tiny | base | small | medium | large-v2 | large-v3 | mock
#     ("mock" skips ASR and returns a stub transcript for testing Gemini + Notion)
#   WHISPER_DEVICE: auto | cuda | cpu
#   WHISPER_COMPUTE_TYPE: cuda -> float16 / int8_float16 ; cpu is forced to int8
WHISPER_MODEL=large-v2
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8_float16

# Google Gemini (meeting analysis)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Notion output (see docs/notion-setup.md)
NOTION_TOKEN=your-notion-internal-integration-secret
NOTION_DATABASE_ID=your-notion-database-id

ALLOWED_ORIGINS=http://localhost:5173
